# Exercici 1
# Demana el nom d'un tècnic i el nom de la xarxa que està instal·lant.
# Després, mostra un missatge amb aquesta informació.

nom = input("Insereix el seu nom: ")
xarxa = input("Insereix el nom de la xarxa que s'està instal·lant: ")

print(f"El tècnic {nom} està instal·lant la xarxa {xarxa}.\n")

# Exercici 2
# Demana la longitud d'un enllaç de fibra en quilòmetres i la velocitat de transmissió
# en Gbps. Mostra quants segons caldrien per transmetre 1 GB de dades.
# Suposa que 1 GB = 8 Gb i que la velocitat es manté constant.

longitud = float(input("Insereis la longitud de l'enllaç de fibra en Km: "))
velocitat = float(input("Insereix la velocitat de transmissió en Gbps: "))

temps = 8 / velocitat

print(f"Per tal de transmetre 1GB de dades mitjançant una línia de {longitud} Km, a una velocitat de {velocitat} Gbps, et caldràn {temps} segons.\n")

# Exercici 3
# Demana el nombre d'hores de feina i el preu per hora d'una instal·lació de xarxa.
# Demana també el preu del material.
# Mostra el cost total de la instal·lació.

hores = float(input("Insereix el nombre d'hores de feina necessàries per fer una instal·lació de xarxa: "))
preu = float(input("Insereix el preu per hora en €: "))
preu_material = float(input("Insereix el preu total del material en €: "))

cost = (hores*preu)+preu_material

print(f"El cost total de la instal·lació és: {cost} €\n")
